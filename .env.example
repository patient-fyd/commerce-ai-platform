# Copy this file to .env for local development and replace the sample passwords.
MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=commerce
MYSQL_USER=commerce_app
MYSQL_PASSWORD=commerce_app_example_password
MYSQL_ROOT_PASSWORD=commerce_root_example_password
MYSQL_PORT=3306
MYSQL_TIMEZONE=Asia/Shanghai
MYSQL_DEFAULT_TIME_ZONE=+08:00
MYSQL_CHARACTER_SET=utf8mb4
MYSQL_COLLATION=utf8mb4_0900_ai_ci
MYSQL_VOLUME_NAME=commerce_ai_mysql_data
MYSQL_MEMORY_LIMIT=768m
MYSQL_CPUS=1.0
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=50
MYSQL_PERFORMANCE_SCHEMA=OFF
MYSQL_TABLE_OPEN_CACHE=400
MYSQL_THREAD_CACHE_SIZE=8

# Apache Doris All-In-One local development (native Apple Silicon by default)
DORIS_IMAGE=apache/doris:all-in-one-4.1.3
DORIS_PLATFORM=linux/arm64
DORIS_QUERY_PORT=9030
DORIS_FE_HTTP_PORT=8030
DORIS_BE_HTTP_PORT=8040
DORIS_TIMEZONE=Asia/Shanghai
DORIS_FE_META_VOLUME_NAME=commerce_ai_doris_fe_meta
DORIS_BE_STORAGE_VOLUME_NAME=commerce_ai_doris_be_storage
DORIS_MEMORY_LIMIT=6g
DORIS_CPUS=4.0
DORIS_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
